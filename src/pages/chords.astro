---
import {getCollection} from 'astro:content';
import ChordProgression from '../components/ChordProgression.astro';
import Layout from '../layouts/Layout.astro';

const progressions = await getCollection('chordProgressions');
---

<Layout title="Chords" breadcrumbs={[]}>
	<h1>Chord progressions</h1>

	<p>Chord progressions I like.</p>

	{
		progressions.map((progression) => (
			<>
				<h2>{progression.data.name}</h2>
				<ChordProgression {...progression.data} />
			</>
		))
	}
</Layout>
