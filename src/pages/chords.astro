---
import Layout from '../layouts/Layout.astro';
import Chord from '../components/Chord.astro';
---

<Layout title="Chords" breadcrumbs={[]}>
	<h1>Chords</h1>

	<p>Chord progressions I like.</p>

	<Chord frets={[-1, 7, 9, 0, 8, 0]} baseFret={6} />
	<Chord frets={[-1, 5, 7, 0, 7, 0]} baseFret={4} />
	<Chord frets={[-1, 3, 5, 0, 5, 0]} />
	<Chord
		frets={[0, 2, 5, 2, 3, 2]}
		barres={[{fret: 2, startString: 2, endString: 6}]}
	/>
</Layout>
