---
import {
	renderFretboard,
	type FretboardChord
} from 'notae/src/index';

export interface Props extends FretboardChord {
	frets: number[];
}

const {frets, ...props} = Astro.props;
const actualFrets = frets.filter((fret) => fret > 0);
const baseFret = Math.min(...actualFrets);
const chord = renderFretboard({
	...props,
	frets,
	baseFret: baseFret > 2 ? baseFret : undefined,
	tuning: ['E', 'A', 'D', 'G', 'B', 'E']
});
---

<Fragment set:html={chord} />
